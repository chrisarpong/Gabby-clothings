# ==============================================================================
# Gabby Newluk - Frontend Environment Variables
# Copy this file to .env.local and fill in the values
# ==============================================================================

# Clerk Authentication (Client-side Customer Accounts)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_key

# Paystack Public Key (Client-side Checkout)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# Convex Cloud URLs
CONVEX_DEPLOYMENT=dev:your-deployment-name
VITE_CONVEX_URL=https://your-deployment-name.convex.cloud
VITE_CONVEX_SITE_URL=https://your-deployment-name.convex.site

# ==============================================================================
# Convex Backend Environment Variables
# These must be set directly in Convex using:
#   npx convex env set <KEY> <VALUE>
# Do NOT put production secrets in your frontend bundle!
# ==============================================================================
# PAYSTACK_SECRET_KEY=sk_test_...
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Gabby Newluk <orders@gabbynewluk.com>
# ARKESEL_API_KEY=your_arkesel_api_key
# GOOGLE_CALENDAR_CREDENTIALS={"type":"service_account",...}
# GOOGLE_CALENDAR_ID=primary
UNSUBSCRIBE_SECRET=
SITE_URL=https://gabbynewluk.com

